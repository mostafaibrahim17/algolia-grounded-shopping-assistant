# ── Algolia application ───────────────────────────────────────────────────────
# Dashboard → Settings → API Keys
ALGOLIA_APP_ID=YourApplicationID

# Admin key: used ONLY by the one-off indexing script (scripts/index-catalog.ts).
# Never ship this to the browser or the agent.
ALGOLIA_ADMIN_KEY=YourAdminApiKey

# Search-only key: the PARENT key the server derives secured keys from.
# It must be search-only (no write/admin ACLs).
ALGOLIA_SEARCH_KEY=YourSearchOnlyApiKey

# The index the assistant is grounded in.
ALGOLIA_INDEX_NAME=products

# ── Agent Studio ──────────────────────────────────────────────────────────────
# Set after `npm run agent:deploy` prints the agent id (or copy it from the
# Agent Studio dashboard).
ALGOLIA_AGENT_ID=YourAgentId

# ── BYO-LLM (OpenAI) ──────────────────────────────────────────────────────────
# Add an OpenAI provider profile once in the Agent Studio dashboard
# (Settings → Agent Studio → LLM providers) using your OpenAI API key.
# Copy the resulting provider profile id here — deploy-agent.ts sends it as
# `providerId`. The model itself (gpt-4) is set in agent/agent.config.json
# and is swappable (e.g. gpt-4o or gpt-4o-mini for lower cost).
ALGOLIA_PROVIDER_ID=YourOpenAIProviderProfileId

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
# Comma-separated origins allowed to call the proxy (the web dev server).
ALLOWED_ORIGIN=http://localhost:5173

# Optional. Leave UNSET on normal networks — the proxy uses {APP_ID}.algolia.net.
# Set it only if your machine's DNS resolver can't resolve that host (point it at
# the DSN host, e.g. YourAppID-dsn.algolia.net, which serves the same API).
# ALGOLIA_API_HOST=YourAppID-dsn.algolia.net
